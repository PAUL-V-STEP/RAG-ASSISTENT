# env.example — переменные окружения RAG-AL (файл комплекта; ТЗ-RAG-AL, раздел 6.3)
# Приоритет: аргумент CLI > переменная окружения > ENV_FILE > .env > значение по умолчанию в settings.py.
# Пустое значение = значение по умолчанию из settings.py. «Текущее значение» — то, что сейчас в коде assistant_api;
#   исполнитель вписывает его на этапе 0 без изменения (docs/normalization_plan.md).
# Имена порогов: *_MIN_SIMILARITY — сходство (попадание при >=), *_MAX_DISTANCE — расстояние (попадание при <=).
# Ключи API сюда не записываются: они задаются в .env, который не коммитится.


# ======================================================================
# Основное приложение
# ======================================================================
# Консольный диалог или пакетный прогон (раздел 17). Тип: enum console | batch
APP_MODE=console
# Файл профиля (6.1, п. 3). Тип: path
ENV_FILE=
# База знаний; относительный путь — от корня проекта. Тип: path
DATA_FILE=ТО автолифта АЛ 3У-М6 — версия для RAG V3.txt
# Каталог Chroma [по умолчанию: текущий путь assistant_api/chroma_db]. Тип: path
CHROMA_DIR=
# Префикс основной коллекции; полное имя kb__<kb_version>. Тип: str
KB_COLLECTION_PREFIX=kb__
# Число чанков для генерации [по умолчанию: текущее значение]. Тип: int 1–20
RETRIEVER_TOP_K=
# Модель генерации ответа [по умолчанию: текущая модель]. Тип: str
LLM_MODEL=
# Таймаут генерации [по умолчанию: текущее значение]. Тип: float 1–120
LLM_TIMEOUT_S=
# Температура генерации [по умолчанию: текущее значение]. Тип: float 0–2
LLM_TEMPERATURE=
# Уровень логирования. Тип: enum DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Лог шагов (раздел 18). Тип: path
PIPELINE_LOG_FILE=logs/pipeline.jsonl

# ======================================================================
# Коррекция ввода (раздел 9)
# ======================================================================
# Шаг [2] целиком. Тип: bool
INPUT_FIX_ENABLED=true
# Замена похожих латинских букв в кириллических словах. Тип: bool
HOMOGLYPH_FIX_ENABLED=true
# Исправление Caps Lock. Тип: bool
CAPSLOCK_FIX_ENABLED=true
# Исправление латинской раскладки. Тип: bool
LAYOUT_FIX_ENABLED=true
# Доля распознанных слов для автоисправления. Тип: float 0–1
LAYOUT_AUTO_MIN_RATIO=0.8
# Ниже — не исправлять; между порогами — подтверждение. Тип: float 0–1
LAYOUT_CONFIRM_MIN_RATIO=0.5
# Минимум латинских слов для автоисправления без глоссарного попадания. Тип: int 1–10
LAYOUT_MIN_LATIN_TOKENS=2
# Что делать в зоне между порогами. Тип: enum confirm | answer_with_note | ignore
LAYOUT_UNCLEAR_ACTION=confirm
# Прибавка к доле за слова, совпавшие с глоссарием или историей. Тип: float 0–0.5
LAYOUT_CONTEXT_BONUS=0.1
# Латинские слова, которые не исправляются. Тип: path
LAYOUT_LATIN_WHITELIST_FILE=assistant_api/data/latin_whitelist.yaml

# ======================================================================
# Нормализация (разделы 10, 11)
# ======================================================================
# Шаги [3]–[6]. Тип: bool
NORMALIZATION_ENABLED=true
# Шаг [4]. Тип: bool
CONTEXTUALIZATION_ENABLED=true
# Шаг [6] и ключ точного кэша. Тип: bool
CANONICALIZATION_ENABLED=true
# Модель contextualization [по умолчанию: быстрая модель провайдера]. Тип: str
NORMALIZER_MODEL=
# Таймаут LLM нормализации (допустимо 5–8 для приёмки). Тип: float 1–30
NORMALIZER_TIMEOUT_S=6
# Повторы при невалидном JSON. Тип: int 0–3
NORMALIZER_RETRIES=1
# Версия правил; входит в ключ кэша. Тип: str
NORMALIZER_VERSION=1
# Пар реплик в контексте. Тип: int 0–10
HISTORY_TURNS=3
# Обрезка ответов ассистента в истории. Тип: int 100–5000
HISTORY_ANSWER_MAX_CHARS=500
# Максимальное удлинение standalone. Тип: float 1–10
REWRITE_MAX_RATIO=4
# Порог нечёткого поиска термина глоссария. Тип: int 50–100
FUZZY_CUTOFF=88
# Ручные дополнения глоссария. Тип: path
GLOSSARY_EXTRA_FILE=assistant_api/data/glossary_extra.yaml
# Собранный глоссарий. Тип: path
GLOSSARY_CANONICAL_FILE=assistant_api/data/glossary_canonical.yaml

# ======================================================================
# Кэш (раздел 12)
# ======================================================================
# Точный кэш. Тип: bool
EXACT_CACHE_ENABLED=true
# Семантический кэш. Тип: bool
SEMANTIC_CACHE_ENABLED=true
# Основной порог: попадание при косинусном **сходстве** ≥ значения [по умолчанию: текущее значение (по ревью — 0.88)]. Тип: float 0–1
SEMANTIC_CACHE_MIN_SIMILARITY=
# Второй порог сходства из текущего кода; назначение подтвердить на этапе 0 и описать в README. Если в коде один порог — переменная не вводится [по умолчанию: текущее значение (по ревью — 0.97)]. Тип: float 0–1
SEMANTIC_CACHE_STRICT_MIN_SIMILARITY=
# Кандидатов при поиске [по умолчанию: текущее значение]. Тип: int 1–20
SEMANTIC_CACHE_TOP_K=
# Время жизни записи, 0 — без ограничения [по умолчанию: текущее значение]. Тип: int ≥ 0
SEMANTIC_CACHE_TTL_S=
# Фильтры по слотам (12, п. 3). Тип: bool
SEMANTIC_CACHE_FILTERS_ENABLED=true
# Префикс индекса; полное имя cache__<kb_version>. Тип: str
CACHE_INDEX_PREFIX=cache__
# Кэшировать ли ответы при fallback нормализации зависимого вопроса. Тип: bool
CACHE_STORE_FALLBACK=false

# ======================================================================
# Уровень Q-A (раздел 13)
# ======================================================================
# Шаг [7]. Тип: bool
QA_LAYER_ENABLED=false
# Режим уровня (13.1). Тип: enum off | shadow | hybrid_only | full
QA_MODE=shadow
# База Q-A. Тип: path
QA_BASE_FILE=assistant_api/data/qa/qa_base.yaml
# Тесты Q-A. Тип: path
QA_TESTS_FILE=assistant_api/data/qa/qa_tests.yaml
# Manifest сборки. Тип: path
QA_MANIFEST_FILE=assistant_api/data/qa/qa_manifest.json
# Префикс коллекции Q-A. Тип: str
QA_COLLECTION_PREFIX=qa_verified__
# Кандидатов при поиске. Тип: int 1–20
QA_TOP_K=5
# Порог direct (стартовый, уточняется calibrate). Тип: float 0–1
QA_DIRECT_MAX_DISTANCE=0.12
# Порог hybrid. Тип: float 0–1
QA_HYBRID_MAX_DISTANCE=0.25
# Минимальный отрыв от другой группы ответов. Тип: float 0–1
QA_MIN_MARGIN=0.03
# Непроверенные записи — максимум hybrid. Тип: bool
QA_REQUIRE_VERIFIED=true
# Стоп-правила вне корпуса (13.7). Тип: bool
QA_STOP_RULES_ENABLED=true
# Проверка чисел после генерации hybrid (13.10). Тип: bool
QA_HYBRID_NUMBER_CHECK=true
# Лог уровня. Тип: path
QA_LOG_FILE=logs/qa_layer.jsonl
# Отчёты утилиты. Тип: path
QA_REPORTS_DIR=reports/qa

# ======================================================================
# Утилита qa_tool (раздел 15) — двойники флагов командной строки
# ======================================================================
# --mode. Тип: enum как QA_MODE
QA_TOOL_MODE=full
# --ignore-verified. Тип: bool
QA_TOOL_IGNORE_VERIFIED=false
# --type. Тип: список через запятую
QA_TOOL_TEST_TYPES=match,contrast,no_match,dialog
# --with-generation. Тип: bool
QA_TOOL_WITH_GENERATION=false
# --json. Тип: enum table | json
QA_TOOL_OUTPUT=table
# --quiet. Тип: bool
QA_TOOL_QUIET=false
# обратный --yes у clear. Тип: bool
QA_TOOL_CONFIRM=true
# --fail-under-match. Тип: float 0–1
QA_TEST_FAIL_UNDER_MATCH=0.9
# --min-direct-share. Тип: float 0–1
QA_TEST_MIN_DIRECT_SHARE=0.6
# --max-contrast-errors. Тип: int ≥ 0
QA_TEST_MAX_CONTRAST_ERRORS=0
# --max-nomatch-errors. Тип: int ≥ 0
QA_TEST_MAX_NOMATCH_ERRORS=0
# --direct-range. Тип: range
QA_CALIBRATE_DIRECT_RANGE=0.04:0.20:0.01
# --hybrid-range. Тип: range
QA_CALIBRATE_HYBRID_RANGE=0.10:0.40:0.02
# --margin-range. Тип: range
QA_CALIBRATE_MARGIN_RANGE=0:0.08:0.01
# --split. Тип: float 0.5–0.9
QA_CALIBRATE_SPLIT=0.7
# --seed. Тип: int
QA_CALIBRATE_SEED=42
# --shuffle. Тип: bool
QA_MANUAL_SHUFFLE=false
# --limit [по умолчанию: 0 (без ограничения)]. Тип: int ≥ 0
QA_MANUAL_LIMIT=

# ======================================================================
# Трассировка (раздел 16)
# ======================================================================
# Блок трассировки. Тип: enum off | summary | full
TRACE_MODE=off
# Куда выводить. Тип: enum console | file | both
TRACE_OUTPUT=console
# Файл трассировки. Тип: path
TRACE_FILE=logs/trace.jsonl
# Показывать промпт, отправленный в LLM. Тип: bool
TRACE_SHOW_PROMPT=true
# Обрезка длинных полей, 0 — без обрезки. Тип: int ≥ 0
TRACE_MAX_CHARS=4000
# Кандидатов Q-A и кэша в блоке. Тип: int 0–20
TRACE_SHOW_CANDIDATES=5
# Цвет в консоли. Тип: enum auto | on | off
TRACE_COLOR=auto

# ======================================================================
# Пакетный прогон (раздел 17)
# ======================================================================
# --input. Тип: path
BATCH_INPUT_FILE=
# --format. Тип: enum auto | txt | yaml | jsonl | csv
BATCH_FORMAT=auto
# --stage. Тип: enum input_fix | normalize | qa | retrieve | full
BATCH_STAGE=full
# --out. Тип: path
BATCH_OUTPUT_DIR=reports/batch
# --profiles. Тип: список путей через запятую
BATCH_PROFILES=
# --compare-with. Тип: path
BATCH_COMPARE_WITH=
# --history-mode. Тип: enum fixed | live
BATCH_HISTORY_MODE=fixed
# --stop-on-error. Тип: bool
BATCH_STOP_ON_ERROR=false
# --repeat. Тип: int 1–10
BATCH_REPEAT=1
# --trace / --no-trace. Тип: bool
BATCH_TRACE=true
# --fail-under. Тип: float 0–1
BATCH_FAIL_UNDER=1.0
# --limit. Тип: int ≥ 0
BATCH_LIMIT=0
# --tags. Тип: список через запятую
BATCH_FILTER_TAGS=
